{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sprint-mode/sm-ui/module-manifest.schema.json",
  "title": "ModuleManifest",
  "description": "Versioned contract between a growth-stack module and the Portal Manager installer (FEAT-3530). A module author publishes one of these; Portal Manager reads it to drive the install cascade.",
  "type": "object",
  "required": [
    "id",
    "manifest_version",
    "module_version",
    "engine_version_range",
    "name",
    "description",
    "config_schema",
    "sections",
    "roles",
    "routes",
    "crons",
    "mcp_tools",
    "metering_keys",
    "bindings_required",
    "migrations_path"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable lowercase slug matching the npm package name segment."
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver of this manifest format. Current: 1.0.0. A Portal Manager that does not recognise the major version refuses to install."
    },
    "module_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver of the module package this manifest describes."
    },
    "engine_version_range": {
      "type": "string",
      "description": "Semver range of the manifest format the module was written against. Installer validates that its own manifest_version satisfies this range."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name for the Portal Manager module picker."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One-line description (no markup)."
    },
    "config_schema": {
      "type": "object",
      "description": "JSON Schema (draft-07) for the config the installer collects from the operator. Portal Manager renders a form from this and validates before provisioning."
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/ModuleSection" },
      "description": "Sections this module adds to the portal's Permissions tab."
    },
    "roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/ModuleRole" },
      "description": "Roles this module introduces on top of the portal's base roles."
    },
    "routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/ModuleRoute" },
      "description": "Routes this module registers (documentation only)."
    },
    "crons": {
      "type": "array",
      "items": { "$ref": "#/$defs/ModuleCron" },
      "description": "Cron triggers the installer must provision in the worker."
    },
    "mcp_tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/ModuleMcpTool" },
      "description": "MCP tools this module exposes."
    },
    "metering_keys": {
      "type": "array",
      "items": { "$ref": "#/$defs/ModuleMeteringKey" },
      "description": "Cost types this module reports to Platform billing via meter()."
    },
    "bindings_required": {
      "$ref": "#/$defs/ModuleBindings",
      "description": "Infrastructure the installer must provision before the module can run."
    },
    "migrations_path": {
      "type": "string",
      "minLength": 1,
      "description": "Path relative to the module package root where numbered migration SQL files live. Installer applies them in lexicographic order."
    }
  },
  "$defs": {
    "ModuleSection": {
      "type": "object",
      "required": ["key", "name", "default_grants"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "default_grants": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["read", "write", "admin", "none"]
          },
          "description": "Default access level per portal role key. Roles not listed default to none."
        }
      }
    },
    "ModuleRole": {
      "type": "object",
      "required": ["key", "name"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "ModuleRoute": {
      "type": "object",
      "required": ["method", "path"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "*"] },
        "path": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "auth_required": { "type": "boolean" }
      }
    },
    "ModuleCron": {
      "type": "object",
      "required": ["cron", "path"],
      "additionalProperties": false,
      "properties": {
        "cron": {
          "type": "string",
          "description": "Standard cron expression (five fields). Must match the wrangler trigger."
        },
        "path": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "ModuleMcpTool": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "ModuleMeteringKey": {
      "type": "object",
      "required": ["key", "unit_label"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "unit_label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "ModuleBindings": {
      "type": "object",
      "required": ["d1", "r2", "secrets", "vars"],
      "additionalProperties": false,
      "properties": {
        "d1": {
          "type": "array",
          "items": { "$ref": "#/$defs/ModuleD1Binding" }
        },
        "r2": {
          "type": "array",
          "items": { "$ref": "#/$defs/ModuleR2Binding" }
        },
        "secrets": {
          "type": "array",
          "items": { "$ref": "#/$defs/ModuleSecret" }
        },
        "vars": {
          "type": "array",
          "items": { "$ref": "#/$defs/ModuleVar" }
        }
      }
    },
    "ModuleD1Binding": {
      "type": "object",
      "required": ["binding"],
      "additionalProperties": false,
      "properties": {
        "binding": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "can_share": {
          "type": "boolean",
          "description": "true when this binding can point at the portal's existing shared DB."
        }
      }
    },
    "ModuleR2Binding": {
      "type": "object",
      "required": ["binding"],
      "additionalProperties": false,
      "properties": {
        "binding": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "ModuleSecret": {
      "type": "object",
      "required": ["name", "required"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "when": {
          "type": "string",
          "description": "Which surface or feature requires this secret."
        }
      }
    },
    "ModuleVar": {
      "type": "object",
      "required": ["name", "required"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "example": { "type": "string" }
      }
    }
  }
}
